# Copy this file to .env and adjust as needed. docker-compose.yml reads
# these values; sensible defaults are used if a variable is unset, but you
# MUST override JWT_SECRET_KEY before deploying anywhere but your laptop.

# --- Database ---
POSTGRES_USER=netmentor
POSTGRES_PASSWORD=netmentor
POSTGRES_DB=netmentor

# --- Backend / Auth ---
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- AI Coach ---
# "rule_based" (default) needs no API key — see app/services/coach.py.
# Set to "llm" and supply LLM_API_KEY to route coaching through a real
# model instead (requires implementing the LLM branch in coach.py).
AI_COACH_PROVIDER=rule_based
LLM_API_KEY=

# --- Frontend ---
# NOTE: Next.js inlines NEXT_PUBLIC_* variables at BUILD time. If you
# change this, rebuild the frontend image (docker compose build frontend)
# rather than just restarting the container.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
